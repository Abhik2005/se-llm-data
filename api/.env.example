# SE-LLM API — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to Git!

# ── Model ──────────────────────────────────────────────────────
MODEL_CHECKPOINT_PATH=checkpoints_sft/sft_final.pt
TOKENIZER_PATH=tokenizer/tokenizer.json

# ── Database ───────────────────────────────────────────────────
# SQLite (development):
DATABASE_URL=sqlite:///./se_llm_api.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/se_llm

# ── Stripe (paid tier — add later) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
